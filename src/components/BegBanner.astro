---
// BegBanner. Deadpan Wikipedia-style donation/download appeal.
// Hidden by default; a small inline script decides whether to show it
// based on per-visitor localStorage state (see gating rules in the script).
const ZIP_HREF = '/kiripedia-2026-08-12.zip';
const ZIP_SUBTITLE_A = '1,834 articles, 882 transcripts';
const ZIP_SUBTITLE_B = '16 MB, fits in you';
const BTC = 'bc1q0xcvzfrzmw482scntfq8l0mex90vfmyy05c83c';
const BTC_HALF_A = BTC.slice(0, 17);
const BTC_HALF_B = BTC.slice(17);
---
<div id="beg-banner" class="beg-banner" hidden>
  <div class="beg-banner-inner">
    <p class="beg-lede">
      <span class="beg-i" aria-hidden="true">i</span>
      <span class="beg-line">Dear reader,</span> <span class="beg-line">we are not begging for money.</span> <span class="beg-line">We are asking you</span> <span class="beg-line">to put KiriPedia up your ass.</span>
    </p>

    <p class="beg-body">
      <a href="/wiki/julian-assange">Julian Assange</a>
      did seven years in an embassy and five in a cell for less than what KiriPedia publishes every day.
    </p>

    <p class="beg-body">
      When they come for us, they will come with a bag over the head, a ship with no flag, and a destination on no chart. The website goes down. The archive vanishes. <strong>History depends on your rectal cavity.</strong>
    </p>

    <p class="beg-body">
      The whole encyclopedia (every article, every transcript, every word John has ever spoken into a microphone) fits on a $4 flash drive the size of a fingernail. Not in the cloud. In you.
    </p>

    <p class="beg-body">
      John did 23 months in federal prison. As a convicted felon he is still barred from voting, from keeping and bearing arms, and from the federal pension he earned over 14 years at the CIA. A pardon restores all three.
    </p>

    <p class="beg-body beg-body-last">
      Bitcoin contributions pay for servers, transcription, and the continued ingestion of John's words into the public record.
    </p>

    <div class="beg-actions">
      <a class="beg-action" href={ZIP_HREF}>
        <div class="beg-action-title beg-download">⬇ Download .zip</div>
        <div class="beg-action-sub">
          <div>{ZIP_SUBTITLE_A}</div>
          <div>{ZIP_SUBTITLE_B}</div>
        </div>
      </a>

      <button class="beg-action beg-action-btc" type="button" data-btc={BTC}>
        <div class="beg-action-title beg-btc">₿ Bitcoin</div>
        <div class="beg-btc-box">
          <div>{BTC_HALF_A}</div>
          <div>{BTC_HALF_B}</div>
        </div>
        <div class="beg-btc-hint">tap to copy</div>
      </button>

      <a class="beg-action" href="https://www.house.gov/representatives/find-your-representative" target="_blank" rel="noopener">
        <div class="beg-action-title beg-download">✉ Write your congressman</div>
        <div class="beg-action-sub">
          <div>ask for a pardon</div>
          <div>house.gov</div>
        </div>
      </a>
    </div>

    <p class="beg-footnote">
      KiriPedia is not a nonprofit. Honestly, this isn't even about the money.
      <br>
      <a href="#" data-beg-dismiss="hard">I already inserted one</a>
    </p>
  </div>
</div>

<style>
.beg-banner {
  font-family: var(--font-serif);
  color: var(--color-base);
  margin: 0 0 18px 0;
}
.beg-banner-inner {
  container-type: inline-size;
  border: 3px solid #b32424;
  background: #fdf2f2;
  padding: 24px 28px 20px 28px;
  position: relative;
}
.beg-close {
  position: absolute;
  top: 8px;
  right: 12px;
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  color: #3366cc;
  background: transparent;
  border: none;
  padding: 4px 6px;
  cursor: pointer;
  letter-spacing: 0.3px;
}
.beg-close:hover { text-decoration: underline; }
.beg-lede {
  margin: 0 0 18px 0;
  /* Always one line on desktop: size the text to the banner's own width. */
  font-size: min(22px, 2.2cqi);
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}
.beg-i {
  position: absolute;
  top: 14px;
  right: 16px;
  display: inline-block;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #b32424;
  color: #fff;
  text-align: center;
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: bold;
  line-height: 20px;
}
.beg-body {
  margin: 0 0 12px 0;
  font-size: 16px;
  line-height: 1.6;
}
.beg-body-last { margin-bottom: 20px; }
.beg-u { text-decoration: underline; }
.beg-nb { white-space: nowrap; }
.beg-line { white-space: nowrap; }

.beg-actions {
  display: grid;
  grid-template-columns: 1fr 1.6fr 1fr;
  gap: 12px;
}
.beg-action {
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 1px solid #a2a9b1;
  background: #fff;
  padding: 16px 12px;
  text-align: center;
  min-height: 100px;
  color: inherit;
  font: inherit;
  cursor: pointer;
}
.beg-action:hover { text-decoration: none; background: #f8f9fa; }
.beg-action-title {
  font-family: var(--font-sans);
  font-size: 17px;
  font-weight: bold;
  margin-bottom: 6px;
  white-space: nowrap;
}
.beg-download { color: #3366cc; }
.beg-btc { color: #f7931a; }
.beg-action-sub {
  font-family: var(--font-sans);
  font-size: 12px;
  color: #72777d;
  line-height: 1.4;
}
.beg-action-sub div { white-space: nowrap; }
.beg-btc-box {
  background: #fff8e1;
  border: 1px dashed #f7931a;
  padding: 8px 6px;
  font-family: 'Courier New', monospace;
  font-size: 13px;
  color: var(--color-base);
  line-height: 1.5;
}
.beg-btc-box div { white-space: nowrap; }
.beg-btc-hint {
  font-family: var(--font-sans);
  font-size: 11px;
  color: #72777d;
  margin-top: 4px;
}
.beg-footnote {
  margin: 16px 0 0 0;
  font-family: var(--font-sans);
  font-size: 11px;
  color: #72777d;
  text-align: center;
  line-height: 1.6;
}
.beg-footnote a { color: #3366cc; white-space: nowrap; }

/* Narrow screens: the lede breaks at the four phrase boundaries. */
@media (max-width: 820px) {
  .beg-lede { font-size: min(20px, 5.1cqi); white-space: normal; text-align: left; }
  .beg-lede .beg-line { display: block; }
}

@media (max-width: 640px) {
  .beg-body { font-size: 14px; }
  .beg-actions { grid-template-columns: 1fr; }
  .beg-banner-inner { padding: 18px 16px; }
}
</style>

<script is:inline>
(function () {
  // Gating rules (hybrid: navigation + real time):
  //   - Warm-up: no banner until the visitor has browsed a few articles.
  //   - Once shown or dismissed, hide for at least 14 days AND keep browsing
  //     a while (a long re-show window) before it can reappear.
  //   - Session lock: once shown in this browser session, do not re-show
  //     while they keep navigating around the site.
  var K = {
    visits: 'kp_beg_visits',
    lastShown: 'kp_beg_last_shown',
    lastShownVisit: 'kp_beg_last_shown_visit',
    session: 'kp_beg_session_seen',
  };
  var DAY = 86400000;
  var WARMUP_VISITS = 4;        // browse ~4 articles before ever seeing it
  var RESHOW_DAYS = 14;         // at least 2 weeks between showings
  var RESHOW_VISITS = 40;       // and at least ~40 more articles browsed

  function num(k) { return parseInt(localStorage.getItem(k) || '0', 10); }
  function set(k, v) { try { localStorage.setItem(k, String(v)); } catch (e) {} }
  function sget(k) { try { return sessionStorage.getItem(k) || ''; } catch (e) { return ''; } }
  function sset(k, v) { try { sessionStorage.setItem(k, String(v)); } catch (e) {} }

  var now = Date.now();
  var visits = num(K.visits) + 1;
  set(K.visits, visits);

  // Session lock: shown once already in this tab session, stay quiet.
  if (sget(K.session)) return;

  var lastShown = num(K.lastShown);
  var lastShownVisit = num(K.lastShownVisit);

  if (lastShown === 0) {
    // Never shown yet: warm-up gate only.
    if (visits < WARMUP_VISITS) return;
  } else {
    // Already shown once: both time AND navigation cooldowns must pass.
    if (now - lastShown < RESHOW_DAYS * DAY) return;
    if (visits - lastShownVisit < RESHOW_VISITS) return;
  }

  set(K.lastShown, now);
  set(K.lastShownVisit, visits);
  sset(K.session, '1');

  var banner = document.getElementById('beg-banner');
  if (!banner) return;
  banner.hidden = false;

  // Dismiss handlers (top × button + bottom links).
  var dismisses = banner.querySelectorAll('[data-beg-dismiss]');
  for (var i = 0; i < dismisses.length; i++) {
    dismisses[i].addEventListener('click', function (e) {
      e.preventDefault();
      banner.hidden = true;
    });
  }

  // Copy BTC on click
  var btcBtn = banner.querySelector('.beg-action-btc');
  if (btcBtn) {
    btcBtn.addEventListener('click', function () {
      var addr = btcBtn.getAttribute('data-btc') || '';
      if (navigator.clipboard) {
        navigator.clipboard.writeText(addr).then(function () {
          var hint = btcBtn.querySelector('.beg-btc-hint');
          if (hint) {
            var orig = hint.textContent;
            hint.textContent = 'copied';
            setTimeout(function () { hint.textContent = orig; }, 1500);
          }
        }).catch(function () {});
      }
    });
  }
})();
</script>
