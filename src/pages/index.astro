---
import WikiLayout from '../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const articles = await getCollection('articles');
const sources = await getCollection('sources');
const count = articles.length;

// ---------- "Updated" timestamp ----------
// Live build-time stamp. Astro static rebuilds on every coordinator push, so
// this advances with the corpus. We pick the max of (most-recent article
// mtime, build time) — the article-mtime branch handles the common case
// where a push edits content; the build-time branch covers schema-only
// rebuilds where no .mdx changed but the site was redeployed.
const articlesDir = fileURLToPath(new URL('../content/articles/', import.meta.url));
let latestContentMs = 0;
try {
  for (const entry of fs.readdirSync(articlesDir)) {
    if (!entry.endsWith('.mdx') && !entry.endsWith('.md')) continue;
    const m = fs.statSync(path.join(articlesDir, entry)).mtimeMs;
    if (m > latestContentMs) latestContentMs = m;
  }
} catch {
  // If the directory walk fails for any reason, fall through to build time.
}
const updatedMs = Math.max(latestContentMs, Date.now());
const updatedIso = new Date(updatedMs).toISOString();

const slugOf = (a) => a.id.replace(/\.mdx?$/, '');

// ---------- Cool numbers strip ----------
// Computed at build time so it always stays in sync with the corpus.

// Sum total transcript duration across all source recordings.
function parseDuration(d) {
  if (!d) return 0;
  const parts = String(d).split(':').map(Number);
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  return parts[0] || 0;
}
const totalSourceSeconds = sources.reduce(
  (acc, s) => acc + parseDuration(s.data.duration),
  0
);
const totalSourceHours = Math.round(totalSourceSeconds / 3600);

// Approximate word count: sum of MDX body lengths divided by avg word length (5.1).
// Pagefind reports its own number; this is the corpus measurement.
const totalWords = articles.reduce(
  (acc, a) => acc + Math.round((a.body ?? '').length / 5.5),
  0
);

// Count people, agencies, places by primary category (or first category).
function categoryOf(a) {
  const cats = a.data.categories ?? (a.data.category ? [a.data.category] : []);
  return cats[0] ?? null;
}
const counts = {};
for (const a of articles) {
  const c = categoryOf(a);
  if (!c) continue;
  counts[c] = (counts[c] ?? 0) + 1;
}
const peopleCount = counts.People ?? 0;
const placesCount = counts.Places ?? 0;
const organizationsCount = counts.Organizations ?? 0;
const programsCount = counts.Programs ?? 0;
const proceduresCount = counts.Procedures ?? 0;
const eventsCount = counts.Events ?? 0;

// Count distinct countries mentioned via wiki-style links to known country slugs.
// A small curated list — anything else gets ignored. Avoids false positives.
const COUNTRY_SLUGS = new Set([
  'afghanistan','pakistan','iran','iraq','yemen','saudi-arabia','israel',
  'jordan','lebanon','libya','syria','egypt','cuba','united-arab-emirates',
  'bahrain','indonesia','greece','russia','china','north-korea','cambodia',
  'thailand','india','romania','kuwait','mexico','spain','united-kingdom',
  'france','germany','poland','lithuania','vietnam','korea',
  'south-korea','dubai',
]);
const countryMentions = new Set();
for (const a of articles) {
  const body = a.body ?? '';
  for (const m of body.matchAll(/\(\/wiki\/([a-z0-9-]+)\)/g)) {
    if (COUNTRY_SLUGS.has(m[1])) countryMentions.add(m[1]);
  }
}
const countriesCount = countryMentions.size;

// Citation count — every <Cite s=... /> in every article body.
let citationsCount = 0;
for (const a of articles) {
  const body = a.body ?? '';
  citationsCount += (body.match(/<Cite\s+s=/g) ?? []).length;
}

// ---------- Featured-article-of-the-day ----------
// Pinned features take precedence until their `until` date (inclusive, UTC).
// After all pins expire, a deterministic daily rotation kicks in: every UTC day
// picks the same article for every visitor, but the pick changes day-over-day.
const pinnedFeatured = [
  { slug: 'hummus', until: '2026-05-27' }, // Hummus pinned through Wed May 27, 2026
];
// Only articles that actually have an infobox image are eligible to be
// featured — we never want the logo placeholder in the featured slot.
const featurable = articles.filter((a) => a.data.infobox?.image);
const rotationPool = featurable.map(slugOf).sort();

function pickFeatured(today /* "YYYY-MM-DD" */) {
  for (const p of pinnedFeatured) {
    if (today <= p.until) return p.slug;
  }
  const [y, m, d] = today.split('-').map(Number);
  const dayNumber = Math.floor(Date.UTC(y, m - 1, d) / 86_400_000);
  return rotationPool[dayNumber % rotationPool.length] ?? slugOf(featurable[0]);
}

const today = new Date().toISOString().slice(0, 10);
const todayMD = today.slice(5);
const initialSlug = pickFeatured(today);
const initialArticle =
  articles.find((a) => slugOf(a) === initialSlug) ?? featurable[0];
const initialImage = initialArticle.data.infobox?.image ?? '/logo.png';

// Lightweight catalog the client script uses to repaint the featured box.
// Restricted to featurable (image-having) articles for the same reason.
const articleCatalog = featurable.map((a) => ({
  slug: slugOf(a),
  title: a.data.title,
  summary: a.data.summary ?? '',
  image: a.data.infobox?.image ?? '/logo.png',
}));

// ---------- On this day ----------
// Aggregate every article's `events` array. Each event becomes
// { date, mmdd, year, description, article_slug, article_title }.
// We render today's matches (sorted newest year first), with a fallback
// message if none.
const allEvents = [];
for (const a of articles) {
  const evs = a.data.events ?? [];
  for (const e of evs) {
    const parts = e.date.split('-'); // YYYY, YYYY-MM, or YYYY-MM-DD
    const year = parts[0];
    const month = parts[1] ?? '';
    const day = parts[2] ?? '';
    const mmdd = month && day ? `${month}-${day}` : null;
    allEvents.push({
      date: e.date,
      year,
      mmdd,
      month_only: !day && month ? `${year}-${month}` : null,
      description: e.description,
      slug: slugOf(a),
      title: a.data.title,
    });
  }
}
// STRICT: same-month-and-day matches only. No fallback to ±N days, no
// month-only fishing, no anywhere-in-the-year. "On this day" must mean on
// this day — anything else is a lie dressed as content. If today has no
// matches, the box renders an honest empty state pointing to the calendar.
// Per-visit client shuffle still happens when today has >OTD_VISIBLE
// matches (rare now, common as the corpus grows).
const OTD_VISIBLE = 4;
let todayEvents = allEvents
  .filter((e) => e.mmdd === todayMD)
  .sort((a, b) => Number(b.year) - Number(a.year))
  .slice(0, OTD_VISIBLE);

// Pool serialization for the client picker. Only day-precise events qualify
// for the OTD box; month-only and year-only entries live in /on-this-day's
// month sections, not here.
const otdPool = allEvents
  .filter((e) => e.mmdd)
  .map((e) => ({
    mmdd: e.mmdd,
    year: e.year,
    html: mdLite(e.description),
    slug: e.slug,
    title: e.title,
  }));

// Inline Markdown renderer for event descriptions (same shape as Infobox)
function mdLite(s) {
  if (s == null) return '';
  return String(s)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

// ---------- Did you know … ----------
// Pool grows with every ingest. The whole pool is shipped to the client as
// JSON; an inline script reshuffles and picks DYK_VISIBLE entries on every
// page load, so the box looks different every time the user lands here.
// SSR fallback: render a deterministic initial slice so no-JS / crawlers /
// pre-hydration paint still show something.
const DYK_VISIBLE = 5;
const allDyk = [];
for (const a of articles) {
  const items = a.data.dyk ?? [];
  for (const text of items) {
    allDyk.push({ text, slug: slugOf(a), title: a.data.title });
  }
}
// Initial SSR slice: rotate slowly across days so the static HTML isn't always
// the same five (helps the seed-three-from-Google use case too).
function initialDyk(today, pool, count) {
  if (pool.length === 0) return [];
  const [y, m, d] = today.split('-').map(Number);
  const seed = Math.floor(Date.UTC(y, m - 1, d) / 86_400_000);
  const out = [];
  const used = new Set();
  for (let i = 0; i < count && i < pool.length; i++) {
    let idx = (seed * 31 + i * 97) % pool.length;
    while (used.has(idx)) idx = (idx + 1) % pool.length;
    used.add(idx);
    out.push(pool[idx]);
  }
  return out;
}
const ssrDyk = initialDyk(today, allDyk, DYK_VISIBLE);
// Pre-render each pool entry's HTML so the client doesn't need a markdown
// parser; it just shuffles and swaps innerHTML.
const dykPoolHtml = allDyk.map((d) => mdLite(d.text));

// ---------- Today, formatted for display ----------
const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const todayDisplay = `${monthNames[Number(today.slice(5,7)) - 1]} ${Number(today.slice(8,10))}`;
---
<WikiLayout title="Main Page" type="website">
  <div class="wiki-content">
    <div class="mainpage-welcome">
      <h1>Welcome to <strong>KiriPedia</strong>,</h1>
      <p>the free encyclopedia of the world as told by <a href="/wiki/john-kiriakou">John Kiriakou</a>, the <a href="/wiki/cia">CIA</a> officer who exposed the agency's <a href="/wiki/cia-torture-program-whistleblowing">torture program</a> and went to prison for it. Everything here comes from his own recorded interviews, and every claim links to the moment he said it.</p>
      <p class="mainpage-stats">
        <strong>{count.toLocaleString()}</strong> articles ({peopleCount} <a href="/category/people">people</a>, {organizationsCount} <a href="/category/organizations">organizations</a>, {placesCount} <a href="/category/places">places</a>, {programsCount} <a href="/category/programs">programs</a>, {proceduresCount} <a href="/category/procedures">procedures</a>, {eventsCount} <a href="/category/events">events</a>), anchored to <strong>{citationsCount.toLocaleString()}</strong> cited timestamps across <strong>{sources.length}</strong> <a href="/sources">source recordings</a> totaling {totalSourceHours} hours of transcribed video and {totalWords.toLocaleString()} words written.
      </p>
      <p class="mainpage-updated" style="font-size:12px; color:var(--color-base--subtle); margin-top:4px">
        Updated <time id="mainpage-updated-time" datetime={updatedIso}>{updatedIso.replace('T', ' ').slice(0, 16)} UTC</time>
      </p>
      <script is:inline>
        (function () {
          var el = document.getElementById('mainpage-updated-time');
          if (!el) return;
          var iso = el.getAttribute('datetime');
          if (!iso) return;
          var then = Date.parse(iso);
          if (isNaN(then)) return;
          function fmt() {
            var diff = Math.max(0, (Date.now() - then) / 1000);
            if (diff < 45) return 'just now';
            if (diff < 90) return 'a minute ago';
            var m = Math.round(diff / 60);
            if (m < 45) return m + ' minutes ago';
            if (m < 90) return 'an hour ago';
            var h = Math.round(m / 60);
            if (h < 24) return h + ' hours ago';
            var d = Math.round(h / 24);
            if (d < 2) return 'yesterday';
            if (d < 30) return d + ' days ago';
            // Fall back to the absolute stamp for older builds.
            return iso.replace('T', ' ').slice(0, 16) + ' UTC';
          }
          el.textContent = fmt();
        })();
      </script>
    </div>

    <section class="mainpage-box tfa" style="margin-top:12px">
      <h2>From today's featured article</h2>
      <p style="float:left; margin-right:12px;">
        <a id="featured-thumb-link" href={`/wiki/${initialSlug}`}>
          <img id="featured-thumb-img" src={initialImage} alt="" width="120" style="border:1px solid var(--color-border-subtle); padding:2px; background:transparent; max-height:160px; object-fit:cover" />
        </a>
      </p>
      <p>
        <strong><a id="featured-title-link" href={`/wiki/${initialSlug}`}>{initialArticle.data.title}</a>.</strong> <span id="featured-summary">{initialArticle.data.summary}</span> <a id="featured-full-link" href={`/wiki/${initialSlug}`}>(Full article…)</a>
      </p>
    </section>

    <section class="mainpage-box" style="margin-top:12px">
      <h2>Browse by topic</h2>
      <p>
        <a href="/category/people">People</a> ·
        <a href="/category/organizations">Organizations</a> ·
        <a href="/category/places">Places</a> ·
        <a href="/category/programs">Programs</a> ·
        <a href="/category/procedures">Procedures</a> ·
        <a href="/category/events">Events</a>
      </p>
    </section>

    <div class="mainpage-grid mainpage-grid-2" style="margin-top:12px">
      <section class="mainpage-box dyk">
        <h2>Did you know …</h2>
        {ssrDyk.length > 0 ? (
          <ul id="dyk-list" data-visible={DYK_VISIBLE}>
            {ssrDyk.map((d) => (
              <li set:html={mdLite(d.text)} />
            ))}
          </ul>
        ) : (
          <p><em>No Did-you-know entries yet. Add a <code>dyk:</code> array to any article's frontmatter to seed this section.</em></p>
        )}
        <script type="application/json" id="dyk-pool" set:html={JSON.stringify(dykPoolHtml)} />
        <script is:inline>
          (function () {
            var poolEl = document.getElementById('dyk-pool');
            var listEl = document.getElementById('dyk-list');
            if (!poolEl || !listEl) return;
            var pool;
            try { pool = JSON.parse(poolEl.textContent); } catch (e) { return; }
            if (!Array.isArray(pool) || pool.length === 0) return;
            var n = parseInt(listEl.getAttribute('data-visible'), 10) || 5;
            // Fisher-Yates partial shuffle — Math.random per page load = fresh on every visit / refresh.
            var idxs = [];
            for (var i = 0; i < pool.length; i++) idxs.push(i);
            var picks = Math.min(n, idxs.length);
            for (var j = 0; j < picks; j++) {
              var swap = j + Math.floor(Math.random() * (idxs.length - j));
              var tmp = idxs[j]; idxs[j] = idxs[swap]; idxs[swap] = tmp;
            }
            var html = '';
            for (var k = 0; k < picks; k++) html += '<li>' + pool[idxs[k]] + '</li>';
            listEl.innerHTML = html;
          })();
        </script>
      </section>

      <section class="mainpage-box otd">
        <h2>On this day, {todayDisplay}</h2>
        {todayEvents.length > 0 ? (
          <ul id="otd-list" data-visible={OTD_VISIBLE} data-today={todayMD}>
            {todayEvents.map((e) => (
              <li>
                <strong>{e.year}.</strong> <span set:html={mdLite(e.description)} /> {' '}
                <a href={`/wiki/${e.slug}`} style="font-size:12px; color:var(--color-base--subtle)">[{e.title}]</a>
              </li>
            ))}
          </ul>
        ) : (
          <p><em>No events recorded for today in KiriPedia's corpus yet. See the <a href="/on-this-day">full year-spanning calendar</a> for what we do have.</em></p>
        )}
        <script type="application/json" id="otd-pool" set:html={JSON.stringify(otdPool)} />
        <script is:inline>
          (function () {
            var poolEl = document.getElementById('otd-pool');
            var listEl = document.getElementById('otd-list');
            if (!poolEl || !listEl) return;
            var pool;
            try { pool = JSON.parse(poolEl.textContent); } catch (e) { return; }
            if (!Array.isArray(pool) || pool.length === 0) return;
            var n = parseInt(listEl.getAttribute('data-visible'), 10) || 4;
            var today = listEl.getAttribute('data-today') || '';
            // STRICT: same-day matches only. No fallback chain. If today has
            // nothing the box stays as the SSR-rendered empty state.
            var src = pool.filter(function (e) { return e.mmdd === today; });
            if (src.length === 0) return;
            // Fisher-Yates partial shuffle.
            var idxs = [];
            for (var i = 0; i < src.length; i++) idxs.push(i);
            var picks = Math.min(n, idxs.length);
            for (var j = 0; j < picks; j++) {
              var swap = j + Math.floor(Math.random() * (idxs.length - j));
              var tmp = idxs[j]; idxs[j] = idxs[swap]; idxs[swap] = tmp;
            }
            // Newest year first within the visible slice (Wikipedia style).
            var chosen = [];
            for (var k = 0; k < picks; k++) chosen.push(src[idxs[k]]);
            chosen.sort(function (a, b) { return Number(b.year) - Number(a.year); });
            var html = '';
            for (var m = 0; m < chosen.length; m++) {
              var e = chosen[m];
              html += '<li><strong>' + e.year + '.</strong> ' + e.html +
                      ' <a href="/wiki/' + e.slug + '" style="font-size:12px; color:var(--color-base--subtle)">[' + e.title + ']</a></li>';
            }
            listEl.innerHTML = html;
          })();
        </script>
        <p style="font-size:12px; margin-top:8px"><a href="/on-this-day">Browse the full calendar →</a></p>
      </section>
    </div>
  </div>

  <!-- Client-side refresh of the featured article so the rotation stays correct
       between Vercel builds. No-op if the build-time pick matches today's pick. -->
  <script is:inline define:vars={{ pinnedFeatured, rotationPool, articleCatalog, initialSlug }}>
    (function () {
      function todayUTC() {
        return new Date().toISOString().slice(0, 10);
      }
      function pickFeatured(today) {
        for (const p of pinnedFeatured) {
          if (today <= p.until) return p.slug;
        }
        const [y, m, d] = today.split('-').map(Number);
        const dayNumber = Math.floor(Date.UTC(y, m - 1, d) / 86400000);
        return rotationPool[dayNumber % rotationPool.length] ?? articleCatalog[0].slug;
      }
      const todaySlug = pickFeatured(todayUTC());
      if (todaySlug === initialSlug) return;
      const meta = articleCatalog.find((a) => a.slug === todaySlug);
      if (!meta) return;
      const titleLink = document.getElementById('featured-title-link');
      const thumbLink = document.getElementById('featured-thumb-link');
      const thumbImg = document.getElementById('featured-thumb-img');
      const fullLink = document.getElementById('featured-full-link');
      const summary = document.getElementById('featured-summary');
      if (titleLink) {
        titleLink.href = '/wiki/' + meta.slug;
        titleLink.textContent = meta.title;
      }
      if (thumbLink) thumbLink.href = '/wiki/' + meta.slug;
      if (thumbImg) thumbImg.src = meta.image;
      if (fullLink) fullLink.href = '/wiki/' + meta.slug;
      if (summary) summary.textContent = meta.summary;
    })();
  </script>
</WikiLayout>
