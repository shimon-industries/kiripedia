---
import WikiLayout from './WikiLayout.astro';
import References from '../components/References.astro';
import Related from '../components/Related.astro';
import TOC from '../components/TOC.astro';
import BegBanner from '../components/BegBanner.astro';
import { list, tsToSeconds } from '../lib/citations.mjs';
import { getEntry } from 'astro:content';
import articleDates from '../data/article-dates.json';

const {
  title, subtitle, categories = [], image, slug,
  infobox, updated, datePublished, published, wikidata, wikipedia, headings = [],
  seoTitle, deck, noindex, wordCount,
} = Astro.props;

const SITE = 'https://www.kiripedia.org';
const ORG_ID = `${SITE}/#org`;
const WEBSITE_ID = `${SITE}/#website`;
const articleURL = slug ? `${SITE}/wiki/${slug}/` : undefined;
const entityID = articleURL ? `${articleURL}#entity` : undefined;
const isPerson = categories.includes('People');
const primaryCategory = categories[0];
const imageURL = image
  ? (image.startsWith('http') ? image : `${SITE}${image}`)
  : `${SITE}/og.png`;

// --- Real dates (git-derived, stable across rebuilds) -----------------------
// Prior behaviour stamped every page dateModified = build date, which marked
// the whole corpus "modified today" on each deploy — a distrust signal. Now we
// use per-article git history (published = first commit, modified = last).
const gd = articleDates[slug] || {};
const pubDate = published ?? datePublished ?? gd.published ?? '2025-01-01';
const modDate = updated ?? gd.modified ?? pubDate;

// --- sameAs grounding (Wikipedia / Wikidata) --------------------------------
function normWikidata(v) {
  if (!v) return null;
  return v.startsWith('http') ? v : `https://www.wikidata.org/wiki/${v}`;
}
function normWikipedia(v) {
  if (!v) return null;
  if (v.startsWith('http')) return v;
  return `https://en.wikipedia.org/wiki/${encodeURIComponent(v.replace(/ /g, '_'))}`;
}
const sameAs = [normWikidata(wikidata), normWikipedia(wikipedia)].filter(Boolean);

// --- Subject entity (Person / Organization / Place / Event) -----------------
// Non-People articles previously got only a generic Article with no typed
// entity. Model the subject so agencies/places/events join the knowledge graph.
const CATEGORY_TO_TYPE = {
  People: 'Person',
  Organizations: 'Organization',
  Agencies: 'GovernmentOrganization',
  Places: 'Place',
  Events: 'Event',
  Operations: 'Event',
};
// If a category isn't typed but the article carries Wikipedia/Wikidata
// grounding, still emit a generic Thing entity so the sameAs links surface —
// otherwise the grounding is added to frontmatter but never rendered.
const entityType = CATEGORY_TO_TYPE[primaryCategory] || (sameAs.length ? 'Thing' : null);

function cleanInfoboxValue(v) {
  return v == null ? undefined : String(v).replace(/\[(.+?)\]\(.+?\)/g, '$1').trim();
}
function infoboxValue(box, keys) {
  if (!box?.data) return undefined;
  for (const k of keys) {
    if (box.data[k]) return cleanInfoboxValue(box.data[k]);
  }
  return undefined;
}
// ISO-parseable date only (YYYY or YYYY-MM-DD); Born/Died are free-text so we
// gate to avoid emitting "circa 1943, Kabul" as a schema date.
function isoDate(v) {
  if (!v) return undefined;
  const m = String(v).match(/\b(\d{4}(?:-\d{2}-\d{2})?)\b/);
  return m ? m[1] : undefined;
}

const jobTitle = isPerson
  ? infoboxValue(infobox, ['Position', 'Role', 'Title', 'Job title', 'Occupation', 'Vocation', 'Function', 'Affiliation', 'Profession'])
  : undefined;

let entitySchema = null;
if (entityType && articleURL) {
  entitySchema = {
    "@type": entityType,
    "@id": entityID,
    "name": title,
    "description": subtitle ?? undefined,
    "url": articleURL,
    "mainEntityOfPage": articleURL,
  };
  if (image) entitySchema.image = imageURL;
  if (sameAs.length) entitySchema.sameAs = sameAs;
  if (entityType === 'Person') {
    if (jobTitle) entitySchema.jobTitle = jobTitle;
    const birth = isoDate(infoboxValue(infobox, ['Born', 'Birth date', 'Date of birth']));
    const death = isoDate(infoboxValue(infobox, ['Died', 'Death date', 'Date of death']));
    const nationality = infoboxValue(infobox, ['Nationality', 'Citizenship']);
    if (birth) entitySchema.birthDate = birth;
    if (death) entitySchema.deathDate = death;
    if (nationality) entitySchema.nationality = nationality;
  }
}

// --- Citations → machine-readable sources -----------------------------------
// The whole value of the site is WHICH interview / timestamp a claim comes
// from. Expose that as Article.citation so AI search can attribute a lifted
// claim back to this page. The per-page store is populated by the wiki route
// before this layout renders (same source References uses).
const rawCites = list(Astro.url.pathname);
const citation = (await Promise.all(rawCites.map(async (c) => {
  const src = await getEntry('sources', c.s);
  const d = src?.data ?? {};
  const url = d.videoId
    ? `https://www.youtube.com/watch?v=${d.videoId}&t=${tsToSeconds(c.t)}s`
    : (d.url ?? undefined);
  const node = { "@type": "CreativeWork", "name": d.title || d.show || c.s };
  if (d.date) node.datePublished = d.date;
  if (url) node.url = url;
  return node;
}))).filter(Boolean);

// --- Article --------------------------------------------------------------
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": subtitle ?? undefined,
  "image": imageURL,
  "url": articleURL,
  "mainEntityOfPage": articleURL,
  "inLanguage": "en",
  "articleSection": primaryCategory,
  "keywords": categories.join(', '),
  "datePublished": pubDate,
  "dateModified": modDate,
  "isAccessibleForFree": true,
  "creditText": "Compiled by Claude from the public statements of John Kiriakou.",
  "author": { "@type": "Organization", "@id": ORG_ID, "name": "KiriPedia", "url": SITE },
  "isPartOf": { "@id": WEBSITE_ID },
  "publisher": { "@id": ORG_ID },
};
if (entitySchema) articleSchema.about = { "@id": entityID };
if (citation.length) articleSchema.citation = citation;
if (wordCount) articleSchema.wordCount = wordCount;

// --- Breadcrumbs: Main page › Category › Article ----------------------------
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Main page", item: `${SITE}/` },
];
if (primaryCategory) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: primaryCategory,
    item: `${SITE}/category/${primaryCategory.toLowerCase()}/`,
  });
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 3,
    name: title,
    item: articleURL,
  });
} else {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: title,
    item: articleURL,
  });
}
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

// Entity node carries its own @context when emitted standalone.
const entitySchemaFull = entitySchema
  ? { "@context": "https://schema.org", ...entitySchema }
  : null;

// Meta description: prefer a purpose-written `deck` (front-loaded ~150-char
// hook) when the article provides one; otherwise fall back to the summary. No
// boilerplate prefix (it wasted the first ~19 snippet chars on every page and
// duplicated across the corpus). Truncation happens centrally in SEO.astro.
function stripMarkdown(s) {
  return String(s ?? '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}
const metaDescription = deck
  ? stripMarkdown(deck)
  : (subtitle ? stripMarkdown(subtitle) : `John Kiriakou's account of ${title}.`);

// --- Search-visible title qualifier -----------------------------------------
// A bare headword ("Gust Avrakotos — KiriPedia") signals nothing in the SERP
// and loses the click to Wikipedia. For people, append a short role/descriptor
// pulled from the infobox so the title earns the click. Kept short and clean:
// first clause only, markdown stripped, capped so Google won't truncate it.
function shortQualifier(v) {
  if (!v) return undefined;
  let s = String(v).split(/[;—–(]/)[0].replace(/\*/g, '').trim();
  s = s.replace(/[\s,.:]+$/, '');
  if (!s || s.length > 38) return undefined;
  return s;
}
const titleQualifier = seoTitle
  ? undefined
  : (isPerson
      ? shortQualifier(jobTitle || infoboxValue(infobox, ['Known for', 'Known For']))
      : shortQualifier(
          infoboxValue(infobox, [
            'Type', 'Role', 'Aka', 'Also known as',
            'Alignment', 'Description', 'Known for', 'Known For',
            'Officially termed',
          ])
        ));

const robots = noindex ? 'noindex, follow' : undefined;
---
<WikiLayout
  title={title}
  seoTitle={seoTitle}
  titleQualifier={titleQualifier}
  description={metaDescription}
  image={image}
  robots={robots}
>
  <div class="wiki-content" data-pagefind-body>
    {/* JSON-LD structured data — Google reads these anywhere in the HTML */}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {entitySchemaFull && <script type="application/ld+json" set:html={JSON.stringify(entitySchemaFull)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {/* Visible breadcrumb nav */}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Main page</a>
      {primaryCategory && (
        <>
          <span class="sep">›</span>
          <a href={`/category/${primaryCategory.toLowerCase()}`}>{primaryCategory}</a>
        </>
      )}
      <span class="sep">›</span>
      <span class="current">{title}</span>
    </nav>

    <BegBanner />
    <h1 class="firstHeading" data-pagefind-meta="title">{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <article class="wiki-body">
      <TOC headings={headings} />
      <slot />
    </article>
    <References />
    <Related slug={slug} />
    {slug !== 'john-kiriakou' && (
      <p class="kiriakou-attribution">
        Sourced from <a href="/wiki/john-kiriakou">John Kiriakou</a>'s on-record public statements. See his profile for the full body of his interviews, podcast appearances, and short-form video.
      </p>
    )}
    {categories.length > 0 && (
      <div class="catlinks">
        <span class="label">Categories:</span>
        {categories.map((c) => <a href={`/category/${c.toLowerCase()}`}>{c}</a>)}
      </div>
    )}
  </div>
</WikiLayout>

<style>
  .kiriakou-attribution {
    margin: 24px 0 8px;
    padding: 10px 14px;
    font-size: 0.9em;
    color: var(--color-base--subtle, #54595d);
    border-left: 3px solid #a2a9b1;
    background: var(--color-bg-sidebar, #f8f9fa);
  }
</style>
